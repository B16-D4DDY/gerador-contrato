<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Gerador de contrato de locação</title><style>*{box-sizing:border-box}
:root{--bg:#faf9f5;--card:#fff;--tx:#1f1e1d;--tx2:#5f5e5a;--bd:#d9d7cf;--ac:#185FA5;--acbg:#E6F1FB;--er:#A32D2D;--ok:#3B6D11}
@media(prefers-color-scheme:dark){:root{--bg:#1f1e1d;--card:#2a2928;--tx:#f1efe8;--tx2:#b4b2a9;--bd:#444441;--ac:#85B7EB;--acbg:#0C447C;--er:#F09595;--ok:#97C459}}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:680px;margin:0 auto;padding:2rem 1rem 3rem}
h1{font-size:22px;font-weight:500;margin:0 0 4px}
.sub{font-size:14px;color:var(--tx2);margin:0 0 1.5rem}
#app{background:var(--card);border:.5px solid var(--bd);border-radius:12px;padding:1.5rem}
.bar{display:flex;gap:4px;margin:0 0 6px}.bar i{flex:1;height:4px;border-radius:2px;background:var(--bd)}.bar i.on{background:var(--ac)}
.cap{font-size:13px;color:var(--tx2);margin:0 0 1.25rem}
.q{font-size:18px;font-weight:500;margin:0 0 4px}.h{font-size:14px;color:var(--tx2);margin:0 0 1rem}
.row{display:flex;gap:12px;flex-wrap:wrap;margin:0 0 12px}
.f{display:flex;flex-direction:column;gap:4px;min-width:0}.f label{font-size:13px;color:var(--tx2)}
input,select{width:100%;height:38px;padding:0 10px;font:inherit;font-size:15px;color:var(--tx);background:var(--card);border:.5px solid var(--bd);border-radius:8px}
input:focus,select:focus{outline:2px solid var(--ac);outline-offset:1px}
button{font:inherit;font-size:15px;height:38px;padding:0 16px;color:var(--tx);background:transparent;border:.5px solid var(--bd);border-radius:8px;cursor:pointer}
button:hover{border-color:var(--tx2)}button:active{transform:scale(.98)}
button.pri{background:var(--ac);border-color:var(--ac);color:var(--card)}
button.lnk{border:0;height:auto;padding:0 4px;font-size:13px;color:var(--ac);text-decoration:underline}
.err{font-size:13px;color:var(--er)}.ok{font-size:13px;color:var(--ok)}
.nav{display:flex;justify-content:space-between;align-items:center;margin-top:1.25rem;gap:8px;flex-wrap:wrap}
.card{border:.5px solid var(--bd);border-radius:12px;padding:1rem 1.25rem}.card p{font-size:14px;line-height:1.7;margin:0 0 8px}.card p:last-child{margin:0}
.v{background:var(--acbg);color:var(--ac);padding:0 4px;border-radius:4px;font-weight:500}button.vb{height:auto;font:inherit;font-size:inherit;font-weight:500;border:0;text-align:left;cursor:pointer;display:inline;line-height:inherit;border-bottom:1px dashed var(--ac)}button.vb:hover{filter:brightness(.95)}.ed{border:.5px solid var(--ac);border-radius:8px;padding:12px 14px;margin:4px 0 12px}
.ext{font-size:14px;color:var(--tx2);min-height:22px;margin-top:8px}.sm{font-size:13px;color:var(--tx2);margin-top:8px}
.note{font-size:13px;color:var(--tx2);margin-top:1rem}</style></head>
