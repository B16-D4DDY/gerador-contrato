function render(focusId){var app=document.getElementById('app');
if(step>=steps.length){app.innerHTML='<div class="bar">'+steps.map(function(){return '<i class="on"></i>';}).join('')+'</div><p class="cap">Revisão final</p>'+review();bind();cpfLive();updExt();var ed=app.querySelector('.ed');var fe=focusId?document.getElementById(focusId):(ed?ed.querySelector('input,select'):null);if(fe)fe.focus();return;}
var st=steps[step],bar=steps.map(function(_,i){return '<i class="'+(i<=step?'on':'')+'"></i>';}).join('');
app.innerHTML='<div class="bar">'+bar+'</div><p class="cap">Pergunta '+(step+1)+' de '+steps.length+'</p><p class="q">'+st.t+'</p><p class="h">'+st.h+'</p>'+st.r()+'<div class="nav"><button type="button" id="back"'+(step===0?' style="visibility:hidden"':'')+'>Voltar</button><button type="button" id="next" class="pri">'+(step===steps.length-1?'Revisar contrato':'Continuar')+'</button></div>';
bind();cpfLive();var el=focusId?document.getElementById(focusId):app.querySelector('input,select');if(el)el.focus();updExt();}
function cpfLive(){var o=document.getElementById('cpflive');if(!o)return;var d=s.cpf.replace(/\D/g,'');if(d.length<11){o.className='sm';o.textContent=d.length?'Digitando… '+d.length+' de 11 números':'';return;}if(cpfOk(s.cpf)){o.className='ok';o.textContent='CPF válido';}else{o.className='err';o.textContent='CPF inválido. Confira os números';}}
function updExt(){var o=document.getElementById('extout');if(o){var t=moneyExt(s.valor);o.textContent=t?'R$ '+money(s.valor)+' — '+t:'';}}
function clr(t,id){if(errs[id]){delete errs[id];var er=t.parentNode.querySelector('.err');if(er)er.remove();}}
function bind(){var app=document.getElementById('app');
app.oninput=function(e){var id=e.target.getAttribute('data-id');if(!id)return;var v=e.target.value;
if(id==='cpf'){v=v.replace(/\D/g,'').slice(0,11).replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d{1,2})$/,'$1-$2');e.target.value=v;}
if(id==='l_cep'||id==='i_cep'){v=v.replace(/\D/g,'').slice(0,8).replace(/(\d{5})(\d)/,'$1-$2');e.target.value=v;}
if(id==='l_uf'||id==='i_uf'){v=v.toUpperCase().slice(0,2);e.target.value=v;}
s[id]=v;clr(e.target,id);if(id==='valor')updExt();if(id==='l_cep')lookupCep('l');if(id==='i_cep')lookupCep('i');if(id==='cpf')cpfLive();};
app.onchange=function(e){var id=e.target.getAttribute('data-id');if(id&&e.target.tagName==='SELECT'){s[id]=e.target.value;clr(e.target,id);}};
app.onkeydown=function(e){if(e.key==='Enter'&&e.target.tagName==='INPUT'){e.preventDefault();var n=document.getElementById('next')||document.getElementById('ed-save');if(n)n.click();}};
var nx=document.getElementById('next');if(nx)nx.onclick=function(){var e={};steps[step].v(e);if(Object.keys(e).length){errs=e;var fid=Object.keys(e)[0];render(fid);errs={};return;}errs={};step++;render();};
var bk=document.getElementById('back');if(bk)bk.onclick=function(){if(editing!==-1)cancelEdit();errs={};step=step>=steps.length?steps.length-1:Math.max(0,step-1);render();};
var ca=document.getElementById('copy-addr');if(ca)ca.onclick=function(){errs={};['rua','num','comp','bairro','cidade','uf','cep'].forEach(function(k){s['i_'+k]=s['l_'+k];});render();};
Array.prototype.forEach.call(app.querySelectorAll('[data-edit]'),function(b){b.onclick=function(){var i=+b.getAttribute('data-edit');if(editing===i)return;if(editing!==-1)cancelEdit();snap=JSON.parse(JSON.stringify(s));editing=i;errs={};render();};});
var ec=document.getElementById('ed-cancel');if(ec)ec.onclick=function(){cancelEdit();render();};
var es=document.getElementById('ed-save');if(es)es.onclick=function(){var e={};steps[editing].v(e);if(Object.keys(e).length){errs=e;var fid=Object.keys(e)[0];render(fid);errs={};return;}editing=-1;snap=null;errs={};render();};
var ag=document.getElementById('again');if(ag)ag.onclick=function(){if(confirm('Limpar todas as respostas e começar de novo?')){editing=-1;snap=null;Object.keys(s).forEach(function(k){if(!/^(ini_ano|ass_)/.test(k))s[k]='';});step=0;render();}};
var gn=document.getElementById('gen');if(gn)gn.onclick=function(){var m=document.getElementById('msg');if(editing!==-1){m.textContent='Salve ou cancele a edição aberta antes de baixar.';return;}
buildDocx(s).then(function(blob){var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='Contrato_Locacao_'+s.nome.trim().split(/\s+/)[0].normalize('NFD').replace(/[^\w]/g,'')+'.docx';document.body.appendChild(a);a.click();setTimeout(function(){URL.revokeObjectURL(a.href);a.remove();},1000);m.textContent='Arquivo gerado. Confira na pasta de downloads.';}).catch(function(x){m.textContent='Não foi possível gerar o arquivo: '+x.message;});};}
function lockScreen(msg){var app=document.getElementById('app');
if(!window.crypto||!crypto.subtle){app.innerHTML='<p class="q">Conexão não segura</p><p class="h">Abra esta página por um endereço https para liberar o gerador.</p>';return;}
app.innerHTML='<p class="q">Digite a senha</p><p class="h">Os dados do locador ficam cifrados neste arquivo. A senha é pedida só uma vez em cada aparelho.</p><div class="row"><div class="f" style="flex:1 1 0"><label for="pw">Senha</label><input id="pw" type="password" autocomplete="current-password"><span class="err" id="pwerr">'+(msg||'')+'</span></div></div><label class="sm" style="display:flex;gap:8px;align-items:center;margin:0 0 12px"><input id="rem" type="checkbox" checked style="width:auto;height:auto"> Lembrar neste aparelho</label><button type="button" id="unl" class="pri">Desbloquear</button>';
var pw=document.getElementById('pw'),b=document.getElementById('unl');pw.focus();
function go(){b.disabled=true;b.textContent='Verificando…';kdf(pw.value,b64(ENC).slice(0,16)).then(unlock).then(function(key){var ok=document.getElementById('rem').checked;return (ok?crypto.subtle.exportKey('raw',key).then(function(r){try{localStorage.setItem('ck',btoa(String.fromCharCode.apply(null,new Uint8Array(r))));}catch(e){}}):Promise.resolve()).then(render);}).catch(function(){lockScreen('Senha incorreta.');});}
b.onclick=go;pw.onkeydown=function(e){if(e.key==='Enter')go();};}
function boot(){var k=null;try{k=localStorage.getItem('ck');}catch(e){}
if(!k||!window.crypto||!crypto.subtle)return lockScreen();
crypto.subtle.importKey('raw',b64(k),'AES-GCM',false,['decrypt']).then(unlock).then(function(){render();}).catch(function(){try{localStorage.removeItem('ck');}catch(e){}lockScreen();});}
document.getElementById('lockbtn').onclick=function(){try{localStorage.removeItem('ck');}catch(e){}location.reload();};
boot();

</script></body></html>
